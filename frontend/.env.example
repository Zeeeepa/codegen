# Codegen API Configuration
VITE_CODEGEN_API_BASE=https://api.codegen.com/v1
VITE_CODEGEN_ORG_ID=your-org-id-here
VITE_CODEGEN_API_TOKEN=your-api-token-here

# Application Configuration
VITE_APP_NAME=Codegen Control Center
VITE_APP_VERSION=1.0.0
VITE_PORT=3000

# Feature Flags
VITE_ENABLE_AUTONOMOUS_MODE=true
VITE_ENABLE_CICD_MONITOR=true
VITE_ENABLE_STATE_INSPECTOR=true
VITE_ENABLE_PERFORMANCE_ANALYTICS=true

# Optimization Settings
VITE_MAX_CONTEXT_TOKENS=8000
VITE_DEFAULT_MODEL=Sonnet 4.5
VITE_POLLING_INTERVAL=2000

# PostgreSQL (Backend)
DATABASE_URL=postgresql://user:password@localhost:5432/codegen

# Iris Configuration
VITE_IRIS_TELEMETRY_ENABLED=true
VITE_IRIS_FEDERATED_LEARNING=false

