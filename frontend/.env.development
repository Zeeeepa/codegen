# Development Environment Configuration

# Codegen API
VITE_CODEGEN_API_BASE=http://localhost:8000/v1
VITE_CODEGEN_ORG_ID=323
VITE_CODEGEN_API_TOKEN=

# Database API
VITE_DATABASE_API_BASE=http://localhost:8000/v1

# Application
VITE_APP_NAME=Codegen Control Center (Dev)
VITE_APP_VERSION=1.0.0-dev
VITE_APP_ENV=development

# Features
VITE_ENABLE_AUTONOMOUS_MODE=true
VITE_ENABLE_TREE_SEARCH=true
VITE_ENABLE_WORKFLOW_CANVAS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_TELEMETRY=false

# Logging
VITE_LOG_LEVEL=debug
VITE_ENABLE_DEBUG=true

# WebSocket
VITE_WEBSOCKET_URL=ws://localhost:8000/ws
VITE_WEBSOCKET_RECONNECT=true

# Performance
VITE_MAX_CONTEXT_SIZE=100000
VITE_MAX_STEPS=50
VITE_POLLING_INTERVAL=2000

