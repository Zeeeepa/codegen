# API Keys for LLM providers
# You must provide the API key for the provider you want to use

# Required for using Anthropic models (e.g., claude-3-*)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Custom Anthropic-compatible endpoint (e.g., for GLM models)
# If not set, uses the default Anthropic API endpoint
# ANTHROPIC_BASE_URL=http://your-custom-endpoint/v1

# Optional: Custom model name override
# If not set, uses the model name specified in code
# ANTHROPIC_MODEL=glm-4.7

# Required for using OpenAI models (e.g., gpt-4*)
OPENAI_API_KEY=your_openai_key_here
