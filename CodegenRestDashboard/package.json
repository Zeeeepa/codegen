{
  "name": "codegen-rest-dashboard",
  "version": "1.0.0",
  "description": "Codegen REST API Dashboard with real-time agent monitoring",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd dashboard && npm run build",
    "build:server": "tsc",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "install:all": "npm install && cd dashboard && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ws": "^8.14.2",
    "axios": "^1.6.2",
    "uuid": "^9.0.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.16",
    "@types/ws": "^8.5.9",
    "@types/uuid": "^9.0.7",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2",
    "playwright": "^1.40.1",
    "@playwright/test": "^1.40.1",
    "concurrently": "^8.2.2"
  },
  "keywords": ["codegen", "dashboard", "rest-api", "real-time", "agent-monitoring"],
  "author": "Codegen Team",
  "license": "MIT"
}

