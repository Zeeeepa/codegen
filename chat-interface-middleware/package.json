{
  "name": "chat-interface-middleware",
  "version": "1.0.0",
  "description": "Middleware for managing web chat interfaces with YAML configuration and browser automation",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsx build.ts",
    "test": "node --test",
    "type-check": "tsc --noEmit",
    "cli": "tsx src/cli/simple-cli.ts",
    "validate-config": "tsx src/cli/index.ts validate"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "zod": "^3.24.2",
    "yaml": "^2.6.0",
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "dotenv": "^16.4.7",
    "winston": "^3.15.0",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "@types/cors": "^2.8.17",
    "typescript": "^5.7.2",
    "tsx": "^4.16.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}