# Voice Automation Hub Configuration

# OpenAI API Key (Required)
OPENAI_API_KEY=sk-your-api-key-here

# Optional API Keys
TAVILY_API_KEY=tvly-your-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (for future use)
DATABASE_URL=sqlite:///./voice_hub.db

# MCP Configuration
MCP_SERVERS_PATH=./mcp_servers
MCP_REGISTRY_URL=https://mcp.run/api/registry

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-here
WEBHOOK_RETRY_ATTEMPTS=3

# Quality Gates
ENABLE_QUALITY_GATES=true
QUALITY_GATE_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/voice_hub.log

# Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Windows Specific
POWERSHELL_PATH=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
CMD_PATH=C:\Windows\System32\cmd.exe

# Agent Configuration
MAX_SUB_AGENTS=10
AGENT_TIMEOUT=600
ENABLE_RECURSIVE_AGENTS=true

# Voice Configuration
VOICE_PROVIDER=web_speech_api  # or openai_whisper
TTS_PROVIDER=web_synthesis  # or openai_tts
VOICE_LANGUAGE=en-US

