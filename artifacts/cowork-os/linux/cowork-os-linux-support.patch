diff --git a/scripts/build-linux.sh b/scripts/build-linux.sh
new file mode 100755
index 0000000..68c2512
--- /dev/null
+++ b/scripts/build-linux.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+
+# CoWork OS Linux Build Script
+# This script builds CoWork OS for Linux platforms
+
+set -e
+
+echo "🏗️  Building CoWork OS for Linux..."
+
+# Ensure we're in the project root
+cd "$(dirname "$0")/.."
+
+# Install dependencies if node_modules doesn't exist
+if [ ! -d "node_modules" ]; then
+    echo "📦 Installing dependencies..."
+    npm install
+fi
+
+# Build the application
+echo "🔨 Building application..."
+npm run build
+
+# Package for Linux
+echo "📦 Creating Linux packages..."
+npm run package:linux
+
+echo "✅ Linux build complete!"
+echo "📁 Packages available in: release/"
+
+# List the generated files
+if [ -d "release" ]; then
+    echo "📋 Generated packages:"
+    ls -la release/ | grep -E "\.(AppImage|deb|rpm)$" || echo "No Linux packages found"
+fi
