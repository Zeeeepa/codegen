# ============================================================================
# OmniNode Full-Stack -- Master Environment Configuration
# Generated by OmniNode Full-Stack Deploy Orchestrator
#
# This is the SINGLE source of truth for all OmniNode environment variables.
# Copy this file to .env and fill in the values before deploying.
#
# Passwords marked [AUTO] will be auto-generated by deploy_all.sh if left blank.
# ============================================================================

# -- General -------------------------------------------------------------------
OMNINODE_ENV=development
# OMNINODE_ENV=production
COMPOSE_PROJECT_NAME=omninode

# -- PostgreSQL (omnibase_infra) -----------------------------------------------
# Port 5436 -- The central relational database for all services
POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                                    # [AUTO] -- generate with openssl rand -hex 32
POSTGRES_DB=omnibase_infra

# 7 databases created by migrations 000-036:
#   omnibase_infra, omniintelligence, omniclaude, omnimemory,
#   omninode_cloud, omnidash_analytics, system

# 6 per-service roles (least-privilege):
# IMPORTANT: Roles are only created when their password is NON-EMPTY.
# Leave a ROLE_*_PASSWORD empty to skip that role (opt-in pattern).
ROLE_OMNIBASE_PASSWORD=                               # [AUTO]
ROLE_OMNIINTELLIGENCE_PASSWORD=                       # [AUTO]
ROLE_OMNICLAUDE_PASSWORD=                             # [AUTO]
ROLE_OMNIMEMORY_PASSWORD=                             # [AUTO]
ROLE_OMNINODE_PASSWORD=                               # [AUTO]
ROLE_OMNIDASH_PASSWORD=                               # [AUTO]

# Role names for validation (used by validate_db_roles):
DB_ROLE_NAMES="role_omnibase role_omniintelligence role_omniclaude role_omnimemory role_omninode role_omnidash"

# -- Redpanda / Kafka (omnibase_infra) ----------------------------------------
# Ports 19092 (internal) / 29092 (external) -- The event bus
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
REDPANDA_INTERNAL_PORT=19092
REDPANDA_EXTERNAL_PORT=29092
KAFKA_CLIENT_ID=omninode-deploy

# OmniDash-required Kafka topics (created in Phase 2, consumed in Phase 5):
OMNIDASH_KAFKA_TOPICS="agent-routing-decisions agent-transformation-events router-performance-metrics agent-actions"

# -- Valkey / Redis Cache (omnibase_infra) -------------------------------------
# Port 16379 -- Platform-wide cache (infra layer)
#
# NOTE: There are TWO Valkey instances in the OmniNode platform:
#   1. Infra Valkey (port 16379) -- Shared platform cache used by runtime
#      services, contract resolver, and skill lifecycle consumers.
#   2. Memory Valkey (port 6379) -- Dedicated to OmniMemory for semantic
#      retrieval caching, embedding cache, and graph query acceleration.
# These are intentionally separate to prevent cache eviction conflicts
# between high-throughput platform operations and memory-layer operations.
VALKEY_HOST=localhost
VALKEY_PORT=16379
VALKEY_PASSWORD=                                      # [AUTO]

# -- Infisical Secrets Manager (omnibase_infra, profile: secrets) --------------
# Port 8880 -- Opt-in secrets management
# Bootstrap circular dependency: these MUST live in .env, not in Infisical
INFISICAL_ADDR=http://localhost:8880
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENCRYPTION_KEY=                             # [AUTO] -- 16-byte hex
INFISICAL_AUTH_SECRET=                                # [AUTO] -- 32-byte hex
INFISICAL_DB_CONNECTION_URI=postgresql://postgres:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/infisical

# Set to empty to disable Infisical (env-only fallback):
# INFISICAL_ADDR=

# -- Keycloak (omnibase_infra, profile: auth) ---------------------------------
# Port 28080 -- OIDC/Authentication
# Set SKIP_KEYCLOAK=true to skip Keycloak entirely
SKIP_KEYCLOAK=false
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=                              # [AUTO]
KEYCLOAK_FRONTEND_URL=http://localhost:28080
KC_DB_URL=jdbc:postgresql://localhost:5436/keycloak

# -- ONEX Runtime Services (omnibase_infra, profile: runtime) ------------------
# omninode-runtime: port 8085
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8085

# runtime-effects: port 8086
RUNTIME_EFFECTS_PORT=8086

# agent-actions-consumer: port 8087
AGENT_ACTIONS_PORT=8087

# intelligence-api: port 8053
INTELLIGENCE_SERVICE_URL=http://localhost:8053
INTELLIGENCE_API_PORT=8053

# contract-resolver: port 8091
CONTRACT_RESOLVER_PORT=8091

# skill-lifecycle-consumer: port 8092
SKILL_LIFECYCLE_PORT=8092

# Phoenix OTLP: port 6006
PHOENIX_OTLP_PORT=6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# -- OmniMemory (omnimemory docker-compose.yml) --------------------------------
# Qdrant Vector DB: port 6333 (HTTP), 6334 (gRPC)
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=                                       # Optional

# Memgraph Graph DB: port 7687 (Bolt), 7444 (HTTP)
MEMGRAPH_HOST=localhost
MEMGRAPH_BOLT_PORT=7687
MEMGRAPH_HTTP_PORT=7444

# Valkey (Memory-local): port 6379
# NOTE: This is the MEMORY-dedicated Valkey, separate from Infra Valkey (16379).
# See the note in the Valkey section above for the architectural rationale.
MEMORY_VALKEY_HOST=localhost
MEMORY_VALKEY_PORT=6379

# Kreuzberg Document Parser: port 8090
KREUZBERG_HOST=localhost
KREUZBERG_PORT=8090

# -- OmniIntelligence (omniintelligence) ---------------------------------------
# Uses intelligence-api (port 8053) from runtime services above
# Database: omniintelligence (created by migration)
OMNIINTELLIGENCE_DB_URL=postgresql://role_omniintelligence:${ROLE_OMNIINTELLIGENCE_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/omniintelligence

# Cross-repo table provisioning (OMN-3531):
# provision-cross-repo-tables.py creates idempotency records in omniintelligence DB
OMNIINTELLIGENCE_ENABLE_CROSS_REPO_TABLES=true

# Plugin module path for discoverability validation:
OMNIINTELLIGENCE_PLUGIN_MODULE=omniintelligence.runtime.plugin

# -- OmniDash (omnidash) -------------------------------------------------------
# Port 3000 -- Real-time observability dashboard
OMNIDASH_PORT=3000
OMNIDASH_ANALYTICS_DB_URL=postgresql://role_omnidash:${ROLE_OMNIDASH_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/omnidash_analytics
OMNIDASH_KAFKA_BROKERS=${KAFKA_BOOTSTRAP_SERVERS}
OMNIDASH_KAFKA_CLIENT_ID=omnidash-dashboard
OMNIDASH_KAFKA_CONSUMER_GROUP=omnidash-consumers-v2
ENABLE_REAL_TIME_EVENTS=true

# -- OmniClaude (omniclaude) ---------------------------------------------------
# Claude Code Plugin -- auto-detects tier from available services
# Database: omniclaude (created by migration)
OMNICLAUDE_DB_URL=postgresql://role_omniclaude:${ROLE_OMNICLAUDE_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/omniclaude
ENABLE_POSTGRES=true

# Emit daemon socket (for hook event publishing to Kafka):
OMNICLAUDE_EMIT_SOCKET=/tmp/omniclaude-emit.sock

# Hook scripts directory (5 hooks: session_start, user_prompt_submit,
# pre_tool_use, post_tool_use, session_end):
OMNICLAUDE_HOOKS_DIR=${HOME}/omninode-workspace/omniclaude/hooks

# LLM Configuration (bring your own keys)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Plugin deployment path (auto-detected)
# OMNICLAUDE_PROJECT_ROOT=

# -- Consul (omnibase_infra, profile: consul) ---------------------------------
# Port 28500 -- Service discovery (opt-in, per omnibase_infra)
CONSUL_HTTP_ADDR=http://localhost:28500
CONSUL_HTTP_PORT=28500
CONSUL_TOKEN=

# -- Autoheal (omnibase_infra, profile: runtime/full) -------------------------
# willfarrell/autoheal:1.2.0 -- Watches containers labeled autoheal=true
# Restarts unhealthy containers (addresses OMN-3428: Kafka consumer hang)
AUTOHEAL_CONTAINER_LABEL=autoheal
AUTOHEAL_INTERVAL=60
AUTOHEAL_START_PERIOD=60

# -- Observability -------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG
ENABLE_OTEL=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006

# -- Agent Mode (Claude Code Operator) ----------------------------------------
# When AGENT_MODE=true, all output is JSON-line formatted for agent parsing
AGENT_MODE=false
# JSON log file (when AGENT_MODE=true):
AGENT_LOG_FILE=/tmp/omninode-agent-deploy.jsonl

