# ============================================================================
# Eversale CLI — Local Configuration
# ============================================================================
# Copy this file to .env and fill in your API credentials.
# The local proxy server will auto-launch and route LLM calls to your
# configured backend.
# ============================================================================

# ─── Backend Selection ──────────────────────────────────────────────────
# Which LLM backend to use: anthropic | openai | ollama | custom
LLM_BACKEND=anthropic

# ─── Anthropic Backend ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com  # (default, or use Z.AI)

# ─── OpenAI Backend ─────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Ollama Backend (local, no key needed) ──────────────────────────────
# OLLAMA_HOST=http://127.0.0.1:11434

# ─── Custom Backend (Z.AI, LM Studio, vLLM, etc.) ──────────────────────
# LLM_BACKEND=custom
# LLM_BACKEND_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_API_KEY=your-z-ai-key-here

# ─── Proxy Server Settings ──────────────────────────────────────────────
# EVERSALE_PROXY_PORT=8765        # Proxy server port (default: 8765)
# EVERSALE_PROXY_HOST=127.0.0.1   # Proxy server host (default: 127.0.0.1)
# EVERSALE_PROXY_LOG=true          # Enable proxy request logging

# ─── Model Configuration ────────────────────────────────────────────────
# The proxy auto-maps eversale model names to actual backend models:
#   glm-5 → claude-sonnet-4-20250514 (Anthropic) / gpt-4o (OpenAI) / qwen2.5:7b (Ollama)
ANTHROPIC_MODEL=glm-5
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-5

# ─── Timeouts ───────────────────────────────────────────────────────────
# LLM_TIMEOUT=120                  # Request timeout in seconds
# GPU_LLM_TIMEOUT_MS=60000         # GPU LLM timeout in milliseconds

