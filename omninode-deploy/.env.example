# =============================================================================
# OmniNode AI — Unified Environment Configuration
# =============================================================================
# Copy to .env and customize:
#   cp .env.example .env
#   # Generate secure passwords:
#   #   openssl rand -hex 32
# =============================================================================

# =============================================================================
# INFRASTRUCTURE — Docker Services
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=omninode-dev-password
POSTGRES_PORT=5436

# Database names
OMNIBASE_INFRA_DB=omnibase_infra
OMNIINTELLIGENCE_DB=omniintelligence
OMNIMEMORY_DB=omnimemory
OMNIDASH_ANALYTICS_DB=omnidash_analytics

# Connection strings (constructed from above)
OMNIBASE_INFRA_DB_URL=postgresql://postgres:omninode-dev-password@localhost:5436/omnibase_infra
OMNIINTELLIGENCE_DB_URL=postgresql://postgres:omninode-dev-password@localhost:5436/omniintelligence
OMNIMEMORY_DB_URL=postgresql://postgres:omninode-dev-password@localhost:5436/omnimemory
OMNIDASH_ANALYTICS_DB_URL=postgresql://postgres:omninode-dev-password@localhost:5436/omnidash_analytics

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_ENVIRONMENT=dev
KAFKA_GROUP_ID=omniclaude-hooks

# Qdrant (Vector Search)
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# Valkey (Cache)
VALKEY_HOST=localhost
VALKEY_PORT=16379
VALKEY_PASSWORD=valkey-dev-password

# Redpanda Console
REDPANDA_CONSOLE_PORT=8080

# =============================================================================
# OMNICLAUDE — Claude Code Integration
# =============================================================================

# Event routing (set to true when Kafka is available)
USE_EVENT_ROUTING=true

# PostgreSQL integration
ENABLE_POSTGRES=true

# Qdrant integration (for semantic memory)
ENABLE_QDRANT=true
QDRANT_COLLECTION=omninode_patterns

# Intelligence API
INTELLIGENCE_API_URL=http://localhost:8053

# =============================================================================
# OMNIINTELLIGENCE — Intelligence Service
# =============================================================================

# FastAPI port
INTELLIGENCE_PORT=8053

# Pattern learning
PATTERN_CONFIDENCE_THRESHOLD=0.7
PATTERN_PROMOTION_MIN_FEEDBACK=5

# =============================================================================
# OMNIMEMORY — Semantic Memory Service
# =============================================================================

# FastAPI port
OMNIMEMORY_PORT=8054

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# OMNIDASH — Dashboard
# =============================================================================

# Dashboard port
OMNIDASH_PORT=3000

# Kafka consumer
OMNIDASH_KAFKA_BROKERS=localhost:19092
OMNIDASH_KAFKA_CLIENT_ID=omnidash-dashboard
OMNIDASH_KAFKA_CONSUMER_GROUP=omnidash-consumers-v2

# Real-time events
ENABLE_REAL_TIME_EVENTS=true

# =============================================================================
# OPTIONAL — LLM API Keys
# =============================================================================
# Only needed if using local LLM delegation or embedding generation
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# =============================================================================
# LOGGING & ENVIRONMENT
# =============================================================================
ONEX_LOG_LEVEL=INFO
ONEX_ENVIRONMENT=development

