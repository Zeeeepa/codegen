# =============================================================================
# OmniNode AI — Full Stack Environment Configuration
# =============================================================================
# Based on canonical omnibase_infra/docker/env-example-full.txt
#
# Copy to .env and customize. deploy.sh will auto-replace __REPLACE_WITH_*
# placeholders with generated secure values on first run.
#
# ⚠️ SECURITY: NEVER use placeholder values in any environment.
#    Generate secure passwords: openssl rand -hex 32
# =============================================================================

# =============================================================================
# Runtime Version
# =============================================================================
RUNTIME_VERSION=0.1.0

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
# Superuser credentials — used for container bootstrap and admin operations
POSTGRES_USER=omninode
POSTGRES_PASSWORD=__REPLACE_WITH_SECURE_PASSWORD__
POSTGRES_DB=omnibase_infra
POSTGRES_PORT=5436

# Per-service database passwords (optional — defaults to POSTGRES_PASSWORD)
# Each service gets its own role scoped to its database only.
# Databases created: omnibase_infra, omniintelligence, omniclaude,
#                    omnimemory, omninode_cloud, omnidash_analytics, infisical_db
#
# ROLE_OMNIBASE_PASSWORD=
# ROLE_OMNIINTELLIGENCE_PASSWORD=
# ROLE_OMNICLAUDE_PASSWORD=
# ROLE_OMNIMEMORY_PASSWORD=
# ROLE_OMNINODE_PASSWORD=
# ROLE_OMNIDASH_PASSWORD=

# =============================================================================
# Kafka / Redpanda Event Bus
# =============================================================================
# Bootstrap servers for Kafka/Redpanda connection.
#
# ⚠️ IMPORTANT: If omniclaude publishes to a remote broker, you MUST set
# this to the same broker. Otherwise the runtime consumes from the local
# Docker Redpanda while omniclaude publishes to a different one.
#
# Local Docker Redpanda (default — self-contained):
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
#
# Remote broker (shared with omniclaude — for development):
# Requires /etc/hosts entry: 192.168.86.200 omninode-bridge-redpanda
# KAFKA_BOOTSTRAP_SERVERS=omninode-bridge-redpanda:9092

# =============================================================================
# Qdrant Vector Database
# =============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# =============================================================================
# Valkey (Redis-compatible) Cache
# =============================================================================
VALKEY_HOST=localhost
VALKEY_PORT=16379
VALKEY_PASSWORD=

# =============================================================================
# OmniDash Analytics
# =============================================================================
# Drizzle ORM connection to omnidash_analytics database
OMNIDASH_ANALYTICS_DB_URL=postgresql://omninode:__REPLACE_WITH_SECURE_PASSWORD__@localhost:5436/omnidash_analytics
OMNIDASH_PORT=3000

# =============================================================================
# OmniIntelligence
# =============================================================================
INTELLIGENCE_DB_URL=postgresql://omninode:__REPLACE_WITH_SECURE_PASSWORD__@localhost:5436/omniintelligence
INTELLIGENCE_API_PORT=8053

# =============================================================================
# OmniMemory
# =============================================================================
MEMORY_DB_URL=postgresql://omninode:__REPLACE_WITH_SECURE_PASSWORD__@localhost:5436/omnimemory

# =============================================================================
# OmniClaude
# =============================================================================
OMNICLAUDE_DB_URL=postgresql://omninode:__REPLACE_WITH_SECURE_PASSWORD__@localhost:5436/omniclaude

# =============================================================================
# Claude Code Integration
# =============================================================================
# ONEX tier controls which features are enabled
ONEX_TIER=foundation

# Hook emission — Unix socket daemon for non-blocking Kafka events
ONEX_EMIT_SOCKET=/tmp/onex-emit.sock
ENABLE_HOOK_EVENTS=true

# Pattern enforcement (requires intelligence pipeline)
ENABLE_LOCAL_INFERENCE_PIPELINE=false
ENABLE_PATTERN_ENFORCEMENT=false

# =============================================================================
# Observability (optional)
# =============================================================================
# Phoenix OTLP exporter for LLM observability
# PHOENIX_HOST=localhost
# PHOENIX_PORT=6006

# =============================================================================
# Docker Network
# =============================================================================
DOCKER_NETWORK=omninode-bridge-network

